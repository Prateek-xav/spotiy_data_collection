# Spotify Age Research - Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── Supabase ──────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Server ────────────────────────────────────────────────────
PORT=5000

# ─── CORS / Frontend ───────────────────────────────────────────
# Set to your deployed Vercel frontend URL (e.g. https://spotiy-data-collection.vercel.app)
# The backend already allows all *.vercel.app origins automatically, but you can
# pin an exact domain here for extra clarity.
FRONTEND_URL=https://spotiy-data-collection.vercel.app
