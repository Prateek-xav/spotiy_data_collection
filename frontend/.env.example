# Spotify Age Predictor Research - Frontend Environment Variables
# Copy this file to .env.local and set your values

# ─── Spotify OAuth (Authorization Code with PKCE Flow) ──────────────────────
# Get your Client ID from: https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Redirect URI — must EXACTLY match what you registered in the Spotify Dashboard
# Local dev:  http://localhost:5173/callback
# Production: https://spotiy-data-collection.vercel.app/callback  (or your actual Vercel URL)
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# ─── Backend API URL ────────────────────────────────────────────────────────
# Local dev:  http://localhost:5000
# Production: https://your-render-service-name.onrender.com  (set this in Vercel env vars)
VITE_API_URL=http://localhost:5000
